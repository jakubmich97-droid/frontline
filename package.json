{
  "name": "frontline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.ts",
    "test:ui": "npm run build && node --test tests/ui.test.mjs",
    "check": "npm test && npm run test:ui"
  },
  "devDependencies": {
    "jsdom": "^30.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
